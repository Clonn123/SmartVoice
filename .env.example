APP_NAME=SmartVoice
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=INFO

RESULT_STORAGE_DIR=data/call_results

# Конфигурация LLM
# Поддерживаемые провайдеры: mock, openrouter
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Конфигурация OpenRouter (требуется если LLM_PROVIDER=openrouter)
# Получить API ключ можно на https://openrouter.ai/keys
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_MODEL=meta-llama/llama-2-70b-chat

# Конфигурация обработки звонков
# Поддерживаемые провайдеры: mock, vosk
CALL_RUNTIME_PROVIDER=mock

# Конфигурация Vosk (требуется если CALL_RUNTIME_PROVIDER=vosk)
# Скачайте модель с https://alphacephei.com/vosk/models и укажите путь к каталогу
VOSK_MODEL_PATH=
VOSK_SAMPLE_RATE=16000
VOSK_FALLBACK_TEXT=да
# Для локального прогона можно указать путь к WAV-файлу
VOSK_TEST_AUDIO_PATH=

MAX_DIALOGUE_TURNS=6
